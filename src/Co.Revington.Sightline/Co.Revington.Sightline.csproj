<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Also run on newer runtimes, so the tool keeps working after the next .NET release. -->
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Co.Revington.Sightline</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- NuGet package: a .NET tool, installed with "dotnet tool install -g Co.Revington.Sightline".
       The command people type stays "sightline". Version and shared details: ..\Directory.Build.props. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sightline</ToolCommandName>
    <!-- Also an MCP server ("sightline mcp"): nuget.org lists it among MCP servers, and reads how to start it
         from .mcp/server.json in the package. DotnetTool stays first, so "dotnet tool install" and dnx work as before. -->
    <PackageType>DotnetTool;McpServer</PackageType>
    <PackageId>Co.Revington.Sightline</PackageId>
    <Title>Sightline</Title>
    <Description>A live, editable map of a .NET solution. See projects, packages, types, dependency injection, HTTP endpoints and the flow behind each request in one page that updates while you edit.</Description>
    <PackageTags>dotnet-tool;roslyn;architecture;dependency-graph;dependency-injection;aspnetcore;endpoints;code-map;visualization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="wwwroot\**" />
    <!-- UI files ship next to the tool binary. Pack=false avoids extra "content" copies in the package. -->
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" Pack="false" />

    <!-- Shown on nuget.org -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Co.Revington.Sightline.Tests" />
    <None Remove="mcp-server.json" />
  </ItemGroup>

  <!-- .mcp/server.json with the version of this package written in. -->
  <Target Name="AddMcpServerJson" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_McpServerJson>$(IntermediateOutputPath)server.json</_McpServerJson>
      <_McpServerText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/mcp-server.json').Replace('{version}', '$(PackageVersion)'))</_McpServerText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_McpServerJson)" Lines="$(_McpServerText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_McpServerJson)" Pack="true" PackagePath=".mcp/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
