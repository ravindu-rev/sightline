<Project>

  <!-- Shared by the two Sightline packages, which are always released together with one version:
         Co.Revington.Sightline           the tool (dotnet tool install, dnx)
         Co.Revington.Sightline.Hosting   the same tool as a package for a project -->

  <PropertyGroup>
    <!-- Local builds use this version. Releases get theirs from .github/scripts/plan-release.sh.
         Raise this number to force a bigger jump, for example to 1.0.0. -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <Authors>Ravindu Wijegunawardhana</Authors>
    <Copyright>Copyright (c) 2026 Ravindu Wijegunawardhana</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ravindu-rev/sightline</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ravindu-rev/sightline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/ravindu-rev/sightline/releases</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
