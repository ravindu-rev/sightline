# Text files are stored with LF and checked out in the platform's style.
* text=auto

# Shell scripts must keep LF everywhere, or bash on the build server fails.
*.sh text eol=lf

*.png binary

# Bundled libraries: keep them out of GitHub's language statistics and diffs.
src/Co.Revington.Sightline/wwwroot/lib/** linguist-vendored

# The TypeScript compiler, exactly as npm ships it (.github/scripts/vendor-typescript.sh): no line ending changes.
src/Co.Revington.Sightline/analyzers/typescript/vendor/** -text linguist-vendored

# The JavaScript and TypeScript sample is part of the documentation, not of Sightline's own code.
samples/shop-node/** linguist-documentation
